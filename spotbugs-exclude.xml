<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs findings excluded on purpose, each with its reason. Everything else fails the build.
  The plugin runs inside a build, on the project's own configuration and classes: values that
  FindSecBugs treats as untrusted input (paths, the flatc command, log messages) come from the
  project's POM, written by the same people who run the build.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- The schema model is immutable records; SchemaType is a sealed interface whose implementations are records too. -->
    <Match>
        <Package name="io.github.mhradek.aurkitu.plugin.core.model"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- flatcPath, schemaName and outputDirectory are plugin parameters set in the project's POM. -->
    <Match>
        <Class name="io.github.mhradek.aurkitu.plugin.AurkituMojo"/>
        <Bug pattern="COMMAND_INJECTION,PATH_TRAVERSAL_IN,CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="io.github.mhradek.aurkitu.plugin.core.SchemaGenerator"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!--
      Neither pattern can backtrack catastrophically: the namespace pattern's repeated group starts with a
      literal '.', and the number pattern has no nested quantifiers. Both only see annotation values and
      namespaces from the project's own code.
    -->
    <Match>
        <Or>
            <Class name="io.github.mhradek.aurkitu.plugin.core.CompositeValidator"/>
            <Class name="io.github.mhradek.aurkitu.plugin.core.SchemaValidator"/>
        </Or>
        <Bug pattern="REDOS"/>
    </Match>

    <!--
      targetClass has been a public, non-final field since 0.0.x. Making it final is a binary-incompatible
      change (japicmp fails the build), so it waits for 2.0; see the Roadmap.
    -->
    <Match>
        <Or>
            <Class name="io.github.mhradek.aurkitu.annotations.types.FieldType"/>
            <Class name="io.github.mhradek.aurkitu.annotations.types.EnumType"/>
        </Or>
        <Field name="targetClass"/>
        <Bug pattern="ME_MUTABLE_ENUM_FIELD"/>
    </Match>
</FindBugsFilter>
